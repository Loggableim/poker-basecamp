---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import NewsletterSignup from '../../components/NewsletterSignup.astro';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const articles = allArticles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categories = [...new Set(articles.map(a => a.data.category))];
const featured = articles[0];
const series = articles.slice(1);
---

<BaseLayout currentPath="/blog" title="📖 Bot-Blog" description="Dev-Tagebuch, Tech-Deep-Dives und Bug-Stories aus der echten Poker-Bot-Entwicklung. Transparent, technisch, kein BS.">
  <div class="page-header">
    <h1>📖 Bot-Blog</h1>
    <p class="intro">Dev-Tagebuch, Tech-Deep-Dives und Bug-Stories aus der echten Poker-Bot-Entwicklung. Transparent, technisch, kein BS.</p>
  </div>

  <div class="categories-filter">
    <span class="category-chip active">Alle</span>
    {categories.map(cat => (
      <span class="category-chip" data-category={cat}>{cat}</span>
    ))}
  </div>

  {featured && (
    <div class="featured-article">
      <a href={`/blog/${featured.slug}`} class="featured-article-card" style="text-decoration:none;color:inherit;">
        <div class="featured-article-content">
          <span style="font-size:0.78rem;color:var(--pink);font-weight:600;letter-spacing:0.5px;text-transform:uppercase;">⭐ Featured</span>
          <h2>{featured.data.title}</h2>
          <p>{featured.data.description}</p>
          <span class="read-more" style="font-size:0.9rem;">Weiterlesen →</span>
        </div>
        <div class="featured-article-visual">{featured.data.image || '📝'}</div>
      </a>
    </div>
  )}

  <section class="section">
    <div class="blog-grid">
      {series.map(article => (
        <a href={`/blog/${article.slug}`} class="blog-card">
          <div class="blog-card-image" style={`background:linear-gradient(135deg,#1a1430,${article.data.category === 'Tagebuch' ? '#0f2a1a' : article.data.category === 'DOM & Browser' ? '#1a0f2a' : '#1a1a0f'});`}>
            {article.data.image || '📝'}
          </div>
          <div class="blog-card-body">
            <div class="blog-meta">
              <span class="category-tag">{article.data.category}</span>
              <span>{article.data.date.toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
            </div>
            <h3>{article.data.title}</h3>
            <p>{article.data.description}</p>
            <div class="blog-card-footer">
              <span>{(article.body ? Math.ceil(article.body.split(/\s+/).length / 200) : 5)} min read</span>
              <span class="read-more">Weiterlesen →</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="series-section">
    <h2 style="font-size:1.4rem;font-weight:700;margin-bottom:20px;">📚 Serien</h2>

    <a href="/blog/architektur-eines-poker-bots" class="series-card">
      <div class="series-number">1</div>
      <div class="series-content">
        <h4>Building a Poker Bot from Scratch — Setup & Chrome CDP</h4>
        <p>Browser-Automation live: Vom Chrome-Start mit Remote Debugging zur ersten Playwright-Instanz.</p>
        <span class="series-status live">🟢 Live — 1 Teil</span>
      </div>
    </a>

    <a href="/blog/dom-reader-win2day" class="series-card">
      <div class="series-number">2</div>
      <div class="series-content">
        <h4>Building a Poker Bot from Scratch — DOM-Reader & Stability</h4>
        <p>Wie man aus einem Playtech-Iframe saubere Spiel-Daten extrahiert — inkl. Hash-basiertem Stabilitätsfilter.</p>
        <span class="series-status live">🟢 Live — 1 Teil</span>
      </div>
    </a>

    <div class="series-card" style="cursor:default;">
      <div class="series-number">3</div>
      <div class="series-content">
        <h4>Building a Poker Bot from Scratch — Decision Engine & GTO</h4>
        <p>Die 3-stufige Engine: Push/Fold, ICM, MDF + Hand-Classifier + Mixed Strategy. Der Kern des Bots.</p>
        <span class="series-status soon">🟡 Bald</span>
      </div>
    </div>

    <div class="series-card" style="cursor:default;">
      <div class="series-number">4</div>
      <div class="series-content">
        <h4>Building a Poker Bot from Scratch — Dashboard & Deployment</h4>
        <p>FastAPI-Dashboard, Multi-Table-Layout, Live-Updates und der Weg in die Produktion.</p>
        <span class="series-status soon">🟡 Bald</span>
      </div>
    </div>
  </section>

  <NewsletterSignup />
</BaseLayout>

<script>
  // Simple client-side category filter
  const chips = document.querySelectorAll('.category-chip');
  const cards = document.querySelectorAll('.blog-card');

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      chips.forEach(c => c.classList.remove('active'));
      chip.classList.add('active');

      const cat = chip.dataset.category;
      cards.forEach(card => {
        if (!cat || !card) { card.style.display = ''; return; }
        const tag = card.querySelector('.category-tag');
        card.style.display = (tag && tag.textContent === cat) ? '' : 'none';
      });
    });
  });
</script>
