---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import NewsletterSignup from '../../components/NewsletterSignup.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map(article => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await article.render();
---

<BaseLayout currentPath="/blog" title={article.data.title} description={article.data.description} image={article.data.image}>
  <article style="max-width:820px;margin:0 auto;padding:110px 2rem 60px;">
    <div style="margin-bottom:30px;">
      <div style="display:flex;gap:12px;font-size:0.78rem;color:var(--muted);margin-bottom:12px;align-items:center;">
        <span class="category-tag" style="padding:2px 10px;border-radius:6px;background:rgba(212,134,184,0.1);color:var(--pink);font-weight:500;">{article.data.category}</span>
        <span>{article.data.date.toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
      </div>
      <h1 style="font-family:'Playfair Display',serif;font-size:2.8rem;font-weight:700;line-height:1.1;margin-bottom:16px;letter-spacing:-0.5px;">{article.data.title}</h1>
      <p style="font-size:1.05rem;color:var(--text-dim);max-width:600px;line-height:1.6;">{article.data.description}</p>
    </div>

    <div class="blog-content">
      <Content />
    </div>

    {article.data.tags && article.data.tags.length > 0 && (
      <div style="margin-top:40px;padding-top:20px;border-top:1px solid var(--border);display:flex;gap:8px;flex-wrap:wrap;">
        {article.data.tags.map(tag => (
          <span style="padding:4px 12px;border-radius:6px;font-size:0.72rem;background:rgba(255,255,255,0.04);color:var(--muted);border:1px solid var(--border);">#{tag}</span>
        ))}
      </div>
    )}

    <div style="margin-top:40px;text-align:center;">
      <a href="/blog" class="btn-wash secondary">← Zurück zum Blog</a>
    </div>
  </article>

  <NewsletterSignup />
</BaseLayout>

<style>
  .blog-content h2 {
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem;
    font-weight: 700;
    margin-top: 40px;
    margin-bottom: 14px;
    line-height: 1.2;
  }
  .blog-content h3 {
    font-size: 1.2rem;
    font-weight: 600;
    margin-top: 30px;
    margin-bottom: 10px;
  }
  .blog-content p {
    margin-bottom: 18px;
    line-height: 1.7;
    color: var(--text);
  }
  .blog-content ul, .blog-content ol {
    margin-bottom: 18px;
    padding-left: 24px;
  }
  .blog-content li {
    margin-bottom: 6px;
    line-height: 1.6;
  }
  .blog-content strong {
    color: var(--gold);
    font-weight: 600;
  }
  .blog-content code {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85em;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(212,134,184,0.08);
    color: var(--pink);
  }
  .blog-content pre {
    margin-bottom: 18px;
    padding: 16px 20px;
    border-radius: 10px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    overflow-x: auto;
  }
  .blog-content pre code {
    background: none;
    color: var(--text);
    padding: 0;
    font-size: 0.82rem;
  }
  .blog-content blockquote {
    border-left: 3px solid var(--pink-dim);
    padding: 10px 18px;
    margin: 20px 0;
    color: var(--text-dim);
    font-style: italic;
    background: rgba(212,134,184,0.04);
    border-radius: 0 8px 8px 0;
  }
  .blog-content hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 30px 0;
  }
  .blog-content img {
    max-width: 100%;
    border-radius: 10px;
    margin: 20px 0;
    border: 1px solid var(--border);
  }
  .blog-content a {
    color: var(--pink);
    text-decoration: underline;
  }
  .blog-content a:hover {
    color: var(--gold);
  }
</style>
